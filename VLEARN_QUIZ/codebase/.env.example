# 9Router local gateway (recommended when using a 9Router dashboard key)
LLM_PROVIDER=9router
LLM_API_BASE=http://127.0.0.1:20128/v1
ROUTER_API_KEY=your_9router_api_key_here
MODEL=your_9router_model_id_here

# Direct Google Gemini alternative:
# LLM_PROVIDER=google
# GEMINI_API_KEY=your_google_gemini_api_key_here
# MODEL=gemini-2.5-flash

# Legacy 9Router config is also recognized without exposing/moving the key:
# GEMINI_API_KEY=your_9router_api_key_here
# GEMINI_API_BASE=http://127.0.0.1:20128/v1
# MODEL=your_9router_model_id_here
